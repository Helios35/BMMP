    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.21.0",
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "prettier --write --ignore-unknown",
      "eslint --fix"
    ],
    "*.{json,jsonc,css,md,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ]
