# BMMP environment. Every key the application reads is listed here, with no values.
# Copy to .env.local for local development. .env.local is git-ignored.
#
# Values are per-environment and are never carried between environments. Staging
# values live in the staging Vercel project; production values live in the
# production Vercel project, backed by a separate Supabase project (D-21).
# Production credentials never exist in a preview environment.
#
# Anything prefixed NEXT_PUBLIC_ is visible in the browser. Never put a secret
# behind that prefix.
#
# Rule: adding a variable means updating this file in the same commit.

# --- Data layer ---------------------------------------------------
# "mock" runs the whole app on fake in-memory data. "supabase" runs it live.
# See PROJECT_SETUP_BMMP.md Section 3.2. This is the only switch between them.
# Unset, empty or misspelled is a hard failure, never a silent fallback (D-16).
DATA_ADAPTER=

# --- Mock runtime behaviour ---------------------------------------
# Server-only, and deliberately NOT NEXT_PUBLIC_ — a behaviour switch behind
# that prefix is visible in the browser. Both are read once at module load by
# src/data/mock/runtime-from-env.ts and are OFF when unset or empty.
#
# The mock has to simulate latency and expose seeded failures or the loading
# and error states in UX_SPEC.md Section 0 and Section 7.2 are unreachable and
# ship broken. Set them in .env.local to see the real thing; Playwright pins
# both to empty and vitest leaves them unset.
#
# MOCK_LATENCY_MS is a "low,high" millisecond range, for example 150,600.
MOCK_LATENCY_MS=
# MOCK_SEEDED_FAILURES is a comma-separated list of entity.method, for example
# batteryRecords.list,alerts.list. A listed method throws on every call.
MOCK_SEEDED_FAILURES=

# --- Supabase -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Vision model (label reading) ---------------------------------
# VISION_PROVIDER selects the implementation. The vendor is not chosen until
# Gate 1 and no vendor name belongs outside src/lib/vision/providers/ (D-25).
# CI runs the fixture provider so no test spends money. Read once at module
# load by src/lib/vision/index.ts; unset, empty or unknown is a hard failure,
# never a fallback, for the same reason as DATA_ADAPTER. "fixture" is the only
# value until a vendor is chosen.
VISION_PROVIDER=
VISION_API_KEY=
VISION_MODEL=

# --- External services --------------------------------------------
NHTSA_RECALL_BASE_URL=

# --- Error tracking -----------------------------------------------
# Needs an account. Owner item on the Section 10 checklist.
ERROR_TRACKING_DSN=

# --- App ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=
